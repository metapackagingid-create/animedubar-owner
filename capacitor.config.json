{
  "appId": "com.animedubar.owner",
  "appName": "Animedubar Owner",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://metapackagingid-create.github.io/animedubar-owner/",
    "cleartext": true,
    "androidScheme": "https",
    "errorPath": "offline.html",
    "allowNavigation": [
      "*.github.io",
      "*.pages.dev"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#090b10"
    }
  }
}